  "S31": "IF(M31<>\"QUALIFIED\",1E+99,IF($B$4=\"Minimum Width\",IF(ISNUMBER(F31),F31,1E+99),IF($B$4=\"Minimum Tray Weight\",IF(ISNUMBER(P31),P31,1E+99),IF($B$4=\"Minimum Support Count\",IF(ISNUMBER(O31),O31,1E+99),1E+99))))",
  "T31": "IF(M31=\"QUALIFIED\",\"Qualified by the existing geometry/material + structural/source gates.\",IF(M31=\"REVIEW REQUIRED\",\"Candidate has incomplete structural/source data; optimizer cannot promote it.\",\"Does not satisfy the current project requirement.\"))"
